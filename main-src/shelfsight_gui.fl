Function {BTN_CB(Fl_Widget* w, void* data)} {
  comment {For non-menu buttons (the ones in groups)} open
} {
  code {// Assume you have a global or accessible AppUI pointer named app_ui
// and it contains: Fl_Input* inp_usr_log; Fl_Input* inp_pwd_log; (etc.)

struct AppUI
{
                Fl_Input* inp_usr-reg;
