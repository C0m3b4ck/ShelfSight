
menu,MainMenu {
menu "File" {
	action "New Window" {newwindow} <<New>>
	action "Open" {%W geturl [Classy::selectfile]} <<Load>>
	action "Back" {%W back}
	action "Forward" {%W forward}
	action "Reload" {%W reload}
	separator
	action "Editor" {edit newfile}
	action "Command window" {Classy::cmd} <<Cmd>>
	action "Builder" {catch {destroy .classy__.builder};Classy::Builder .classy__.builder} <<Builder>>
	action "Configure menu" {Classy::Config dialog -node {Menus Application MainMenu}} <<ConfigureMenu>>
	action "Configure toolbar" {Classy::Config dialog -node {Toolbars Application MainTool}} <<ConfigureTool>>
	action "Configure application" {Classy::Config dialog} <<Configure>>
	action "Close" "[winfo toplevel %W] destroy" <<Close>>
}
menu "Help" {
	action "Application" {Classy::help application} <<Help>>
	separator
	action "ClassyTk" {Classy::help ClassyTk} <<HelpClassyTk>>
	action "Help" {Classy::help classy_help} <<HelpHelp>>
}
}
toolbar,MainTool {
	action open "Open" {%W geturl file:[Classy::selectfile]}
	separator
	action back "Back" {%W back}
	action forward "Forward" {%W forward}
	action reload "Reload" {%W reload}
}